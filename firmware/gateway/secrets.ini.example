; Copie para secrets.ini (ignorado pelo git) e preencha.
[secrets]
; gateway-esp32-wifi / gateway-esp32-dual
wifi_ssid     = aguadaap
wifi_pass     = TROCAR
; gateway-esp32-aguada-web
web_wifi_ssid = TROCAR
web_wifi_pass = TROCAR
; gateway-c3-usb-wifi-ch11 (espelho MQTT): broker do site
mqtt_host     = 192.168.0.X
mqtt_user     = aguada
mqtt_pass     = TROCAR
